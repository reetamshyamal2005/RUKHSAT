# RUKHSAT — Local Environment Variables Configuration
# Copy this file to '.env.local' in the same folder and fill in your actual credentials.
# Do NOT commit '.env.local' to git!

# 1. MongoDB Atlas Configuration
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=rukhsat

# 2. Gmail SMTP Server Configuration
# Use your dedicated Gmail email and generate a 16-character App Password.
SMTP_USER=your-farewell-email@gmail.com
SMTP_PASS=abcd efgh ijkl mnop

# 3. Backblaze B2 Storage Configuration (S3 Compatible)
B2_APPLICATION_KEY_ID=your_b2_application_key_id
B2_APPLICATION_KEY=your_b2_secret_application_key
B2_ENDPOINT=s3.us-east-005.backblazeb2.com
B2_BUCKET_NAME=your-b2-bucket-name

# 4. Admin Security Password
# The secret key required in 'admin.html' to upload photos and videos.
ADMIN_SECRET=my_farewell_admin_secret
